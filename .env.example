# Server-only. Never prefix these with VITE_.
TMDB_API_KEY=your_tmdb_api_key_here

# Optional. Enables resolving official broadcaster YouTube live streams into embeds.
YOUTUBE_API_KEY=

# TheSportsDB v1 free shared key. Premium keys also work.
SPORTS_API_KEY=123

# Comma-separated Internet Archive collections used for free public-domain films.
ARCHIVE_COLLECTIONS=feature_films,public_domain,opensource_movies
